# ============================================================
# Production environment template.
# Copy this file to "devops/.env.prod" (git-ignored) and fill in
# real values. Never commit the populated file.
#
#   cp devops/.env.prod.example devops/.env.prod
# ============================================================

COMPOSE_PROJECT_NAME=parking-system-prod

# --- Database -------------------------------------------------
DB_USER=parking_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- JWT (min 64 chars, unique per environment, rotate on leak) ---
JWT_SECRET=parking-system-prod-jwt-secret-2026-abcdefghijklmnopqrstuvwxyz-0123456789

# --- Spring profile ----------------------------------------------
SPRING_PROFILES_ACTIVE=production

# --- Published app port -------------------------------------------
API_GATEWAY_PORT=8086

# --- Grafana --------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
