# ============================================================
# Local development defaults - safe to commit.
# Used automatically by start-system.ps1 / start-full-system.ps1.
# DO NOT put real/production secrets in this file.
# ============================================================

COMPOSE_PROJECT_NAME=parking-system-dev

# --- Database -------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5433

# --- Redis ------------------------------------------------------
REDIS_PASSWORD=

# --- JWT (dev only - every environment must set its own) --------
JWT_SECRET=parking-system-dev-jwt-secret-2026-abcdefghijklmnopqrstuvwxyz-0123456789

# --- Spring profile ----------------------------------------------
SPRING_PROFILES_ACTIVE=development

# --- Published app port -------------------------------------------
API_GATEWAY_PORT=8086

# --- pgAdmin (dev-only tool, see docker-compose.override.yml) -----
PGADMIN_EMAIL=admin@parking.com
PGADMIN_PASSWORD=admin

# --- Grafana --------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin123
